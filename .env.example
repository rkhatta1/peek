# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_SITE_URL=http://localhost:3000

# Set these on the Convex deployment with `pnpm convex env set NAME`.
# Better Auth
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Workspace labels
PEEK_WORKSPACE_NAME=Client infrastructure
NEON_PROJECT_NAME=Neon Postgres
NEON_ENVIRONMENT=Production
UPSTASH_DATABASE_NAME=Upstash Redis
UPSTASH_ENVIRONMENT=Staging

# Provider credentials (server-side only; never use a VITE_ prefix)
NEON_DATABASE_URL=
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
UPSTASH_EMAIL=
UPSTASH_API_KEY=
UPSTASH_DATABASE_ID=
