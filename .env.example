# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_SITE_URL=http://localhost:3000

# Set these on the Convex deployment with `pnpm convex env set NAME`.
# Better Auth
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Managed development-only code for the authentication access gate.
PEEK_ACCESS_CODE=

# Credential envelope encryption (server-side only; never use a VITE_ prefix)
# Generate with: openssl rand -base64 32
PEEK_CREDENTIAL_ENCRYPTION_KEY=
# Set only while rotating the encryption key, then remove it.
PEEK_CREDENTIAL_PREVIOUS_ENCRYPTION_KEY=
